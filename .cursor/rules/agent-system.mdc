description: Maintain the shared Codex and Cursor agent system without adapter drift.
globs: ["AGENTS.md", ".agents/**/*.md", ".agents/**/*.py", ".cursor/agents/**/*.md", ".cursor/rules/**/*.mdc", ".codex/agents/**/*.toml"]
alwaysApply: false
